{
  "dependencies": {
    "railway": "^3.16.0"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "lint": "oxlint .railway .github/workflows/scripts",
    "lint:fix": "oxlint --fix .railway .github/workflows/scripts",
    "format:check": "oxfmt --check .railway .github/workflows/scripts",
    "format": "oxfmt --write .railway .github/workflows/scripts",
    "typecheck": "tsc --noEmit"
  }
}