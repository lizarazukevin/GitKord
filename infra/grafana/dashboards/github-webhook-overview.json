  "description": "Tracks the health of GitHub's webhook deliveries into our app.\n\nMeasures:\n- Processing latency\n- Traffic\n- Failure rates",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "liveNow": false,
