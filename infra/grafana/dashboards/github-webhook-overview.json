        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.0.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum(rate(operation_errors_total{\n    event_name!=\"GET /metrics\",\n    event_name!=\"GET /healthz\"}[5m])\n    ) / sum(rate(operation_duration_sec_count{\n        event_name!=\"GET /metrics\",\n        event_name!=\"GET /healthz\"\n        }[5m])) * 100 unless sum(rate(operation_duration_sec_count{event_name!=\"GET /metrics\",\n        event_name!=\"GET /healthz\"}[5m])) == 0",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Global Error Rate %",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The slowest 5% of all operations, any kind, in the current window.\n\nE.g. \"p95 = 850ms\" means 95% of traffic finished faster than 850ms.",
